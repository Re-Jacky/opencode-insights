{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@rejacky/opencode-insights",
  "version": "1.0.0",
  "description": "OpenCode V2 TUI plugin for token/TPS metrics, session analysis, subagent status, and provider usage.",
  "type": "module",
  "author": "opencode-insights contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Re-Jacky/opencode-insights.git"
  },
  "homepage": "https://github.com/Re-Jacky/opencode-insights#readme",
  "bugs": {
    "url": "https://github.com/Re-Jacky/opencode-insights/issues"
  },
  "main": "./dist/tui.js",
  "types": "./dist/tui.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "DEVELOPMENT.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "debug": "npm run build && node scripts/dev.js debug",
    "revert-debug": "node scripts/dev.js revert",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "opencode",
    "plugin",
    "llm",
    "tui",
    "tps",
    "subagent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/theme": "^2.0.11",
    "@opentui/core": "^0.5.10",
    "@opentui/solid": "^0.5.10",
    "@types/node": "^24.12.2",
    "solid-js": "^1.9.12",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.11",
    "jsonc-parser": "^3.3.1"
  }
}
